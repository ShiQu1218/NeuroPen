{
  "name": "neuropen",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/check-env.ps1",
    "doctor:gpu": "powershell -ExecutionPolicy Bypass -File scripts/check-env.ps1 -RequireGpuToolchain",
    "setup": "npm run doctor && npm ci",
    "generate:i18n": "node scripts/generate-i18n-locales.js",
    "dev": "npm run generate:i18n && vite",
    "build": "npm run generate:i18n && tsc && vite build",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1",
    "build:exe:local-stt": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -LocalStt",
    "build:exe:gpu": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -Gpu",
    "build:bundle": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -Bundle",
    "build:bundle:local-stt": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -Bundle -LocalStt",
    "build:bundle:gpu": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -Bundle -Gpu",
    "test": "cargo test --quiet --manifest-path src-tauri\\Cargo.toml",
    "check": "npm run build && npm run test",
    "preview": "vite preview",
    "tauri": "tauri",
    "version": "node scripts/sync-version.js && git add src-tauri/Cargo.toml src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "katex": "^0.16.37",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalkFlow",
  "version": "0.1.1",
  "identifier": "com.talkflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TalkFlow",
        "width": 800,
        "height": 600,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "TalkFlow 設定",
        "width": 760,
        "height": 640,
        "visible": false,
        "center": true
      },
      {
        "label": "preview",
        "title": "Output Preview",
        "width": 340,
        "height": 240,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true
      },
      {
        "label": "quick-action",
        "title": "Quick Action",
        "width": 44,
        "height": 44,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "recording-indicator",
        "title": "Recording",
        "width": 120,
        "height": 60,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.openai.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "cuda-libs/*.dll": "./"
    }
  }
}
